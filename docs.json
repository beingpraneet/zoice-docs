{
    "$schema": "https://zoice.com/",
    "theme": "mint",
    "name": "Zoice Documentation",
    "colors": {
        "primary": "#16A34A",
        "light": "#07C983",
        "dark": "#15803D"
    },
    "favicon": "/logo.svg",
    "navigation": {
