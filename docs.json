                    },
                    {
                        "group": "AI Video",
                        "pages": [
                            "ai-video/intro",
                            "ai-video/how-to-generate",
                            "ai-video/prompts",
                            "ai-video/faq"
                        ]
                    },
                    {
                        "group": "AI Image",
                        "pages": [
                            "ai-image/intro",
                            "ai-image/how-to-generate",
                            "ai-image/prompts",
                            "ai-image/faq"
                        ]
                    },
                    {
                        "group": "AI Voice",
                        "pages": [
                            "ai-voice/intro",
                            "ai-voice/how-to-generate",
                            "ai-voice/best-practices",
                            "ai-voice/faq"
                        ]
                    },
                    {
                        "group": "AI Avatar",
                        "pages": [
                            "ai-avatar/intro",
                            "ai-avatar/create-avatar",
                            "ai-avatar/upload-guidelines",
                            "ai-avatar/faq"
                        ]
                    },
                    {
                        "group": "Models",
                        "pages": [
                            "models/images",
